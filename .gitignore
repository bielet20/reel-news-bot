# Entorno y secretos
.env
*.env
.env.*
*.env.*

# Articulos de prueba locales (no son parte del codigo)
articulo_*.txt
jtx_jito.txt

# Logs de jobs
_job_*.log

# Salidas generadas
output/

# Datos de usuario (biblioteca, música, plantillas, uploads)
_library/
_music/
_templates/

# Tokens OAuth de redes sociales (no subir a GitHub)
_tokens/

# Destinos de almacenamiento configurados en /settings: rutas locales y
# enlaces de Drive/NAS especificos de cada equipo, no se sube al repo.
_config/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Temporales de yt-dlp / moviepy
_ytsrc_*
_tmp_*
_mus_audio_*

# Imágenes temporales y uploads
_img_cache/
_uploads/
_imgs_*/

# SadTalker: modelos (~1.5 GB) y entorno virtual
vendor/sadtalker/checkpoints/
vendor/sadtalker/venv/

# Certificados CA locales (p.ej. si un antivirus/proxy hace inspeccion TLS
# y hace falta inyectarlo en el build de Docker). Especifico de cada equipo,
# no se sube al repo.
certs/*
!certs/.gitkeep

# macOS
.DS_Store
