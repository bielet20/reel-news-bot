# Todas estas variables son OPCIONALES: el bot funciona igual sin ninguna
# (usa fallbacks automaticos en cada paso). Configuralas solo si quieres
# mejorar la calidad de un paso en particular.

# =============================================================================
# GUION DEL REEL
# Orden de prioridad: Ollama (local) -> LM Studio (local) -> Claude -> Gemini -> Groq -> extractivo
# =============================================================================

# Ollama corriendo en local (gratis, sin internet). https://ollama.com
# Si esta levantado se usa primero que todo.
OLLAMA_MODEL=llama3.2

# Si tenes LM Studio (https://lmstudio.ai) con el servidor local corriendo
# (Developer > Start Server, puerto 1234 por defecto) y Ollama no esta
# disponible, se usa el modelo indicado aca. Identificador tal cual figura en
# LM Studio (ver `lms ps` o la pestana Developer). Default: qwen/qwen3-8b.
LMSTUDIO_MODEL=qwen/qwen3-8b

# Claude (Anthropic) — alta calidad. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini 2.0 Flash — alternativa gratuita (1500 peticiones/dia). https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Groq (Llama 3.3 70B) — alternativa gratuita (14400 peticiones/dia). https://console.groq.com/keys
GROQ_API_KEY=...

# =============================================================================
# VOZ NARRADA (TTS)
# =============================================================================

# Voz de edge-tts (gratis, sin API key). Lista completa: edge-tts --list-voices
TTS_VOICE=es-ES-AlvaroNeural

# ElevenLabs — voz de alta calidad (requiere cuenta). https://elevenlabs.io/
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# =============================================================================
# IMAGENES DE FONDO
# =============================================================================

# Pexels — fotos reales relacionadas al tema (gratis). https://www.pexels.com/api/
PEXELS_API_KEY=...

# Pixabay — alternativa a Pexels (gratis). https://pixabay.com/api/docs/
PIXABAY_API_KEY=...

# Unsplash — otra fuente de imagenes (gratis). https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=...

# =============================================================================
# AVATAR LIP-SYNC (D-ID)
# =============================================================================

# D-ID — genera avatar hablando a partir de imagen + audio. https://www.d-id.com/
DID_API_KEY=...

# =============================================================================
# SUBIDA AUTOMATICA A YOUTUBE
# =============================================================================

# Credenciales OAuth de YouTube Data API v3.
# Guia de configuracion: scripts/youtube_auth.py
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...
