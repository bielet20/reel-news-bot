# Todas estas variables son OPCIONALES: el bot funciona igual sin ninguna
# (usa fallbacks automaticos en cada paso). Configuralas solo si quieres
# mejorar la calidad de un paso en particular.

# =============================================================================
# GUION DEL REEL
# Orden de prioridad: Ollama (local) -> LM Studio (local) -> Claude -> Gemini -> Groq -> extractivo
# =============================================================================

# Ollama corriendo en local (gratis, sin internet). https://ollama.com
# Si esta levantado se usa primero que todo.
OLLAMA_MODEL=llama3.2

# Si tenes LM Studio (https://lmstudio.ai) con el servidor local corriendo
# (Developer > Start Server, puerto 1234 por defecto) y Ollama no esta
# disponible, se usa el modelo indicado aca. Identificador tal cual figura en
# LM Studio (ver `lms ps` o la pestana Developer). Default: qwen/qwen3-8b.
LMSTUDIO_MODEL=qwen/qwen3-8b

# Claude (Anthropic) — alta calidad. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini 2.0 Flash — alternativa gratuita (1500 peticiones/dia). https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Groq (Llama 3.3 70B) — alternativa gratuita (14400 peticiones/dia). https://console.groq.com/keys
GROQ_API_KEY=...

# =============================================================================
# VOZ NARRADA (TTS)
# =============================================================================

# Voz de edge-tts (gratis, sin API key). Lista completa: edge-tts --list-voices
TTS_VOICE=es-ES-AlvaroNeural

# ElevenLabs — voz de alta calidad (requiere cuenta). https://elevenlabs.io/
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# =============================================================================
# MONTAJE DE VIDEOCLIP — FONDOS CON VIDEO IA (ComfyUI local)
# =============================================================================
# La seccion /montaje genera el fondo de cada seccion de la letra como VIDEO
# real (texto->video puro con Wan2.2-T2V + LoRA Lightning, encadenando renders
# de ~4s para cubrir la seccion entera) y, si "voz femenina" esta activo,
# lip-sync con LatentSync. Todo via el ComfyUI local (E:\AI-Studio). El backend
# corre en Docker y llega al host por host.docker.internal (ver extra_hosts en
# docker-compose.yml). Si ComfyUI no responde -> imagenes fijas (Pollinations).
#
# En /montaje se elige el GENERADOR de vídeo (selector "Fondos"):
#   - wan22  (local, default) — Wan2.2-T2V. Mejor calidad open. Descarga:
#              bash scripts/descargar_wan_t2v.sh   (~14 GB)
#   - ltx    (local, rápido)  — LTX-Video 2B. Casi tiempo real. Descarga:
#              bash scripts/descargar_ltx.sh       (~5.7 GB, el GGUF ya viene)
#   - fal    (API de pago)    — fal.ai (Hailuo/MiniMax, Kling, Luma...). Pon FAL_KEY.
#   - imagen (sin ComfyUI)    — imagen fija Pollinations + Ken Burns. Siempre disponible.
# Si el generador elegido no está disponible, cae a "imagen" sin abortar.

COMFY_URL=http://host.docker.internal:8188

# Centro de Control de AI Studio (E:\AI-Studio\Centro-Control.bat, puerto 8090):
# panel del host que arranca/para ComfyUI y LM Studio. Si responde, /montaje
# muestra un botón "Arrancar ComfyUI/LM Studio" en vez de pedir abrir un .bat.
CONTROL_CENTER_URL=http://host.docker.internal:8090

# Modelo de faster-whisper para sincronizar la letra con el audio en /montaje.
# base (~140 MB, flojo con música) | small (~460 MB, recomendado) | medium (~1.5 GB, mejor pero lento en CPU)
# Se descarga solo la 1a vez al volumen hf_cache.
WHISPER_MODEL=small

# ── API externa fal.ai (opcional) ────────────────────────────────────────────
# Cuenta en https://fal.ai -> API Keys. Una key da acceso a muchos modelos.
# FAL_KEY=...
# Modelo por defecto (id de fal.ai). Alternativas buenas calidad/precio:
#   fal-ai/minimax/hailuo-02/standard/text-to-video   (~$0.03-0.05/s, cinematográfico)
#   fal-ai/kling-video/v1.6/standard/text-to-video    (~$0.025-0.05/s, buen movimiento)
#   fal-ai/luma-dream-machine/ray-2                    (rápido)
#   fal-ai/wan-t2v                                     (= el local, hosteado)
# FAL_MODEL=fal-ai/minimax/hailuo-02/standard/text-to-video
# LM Studio del host para que un LLM escriba el guion visual desde la letra.
# Si no esta, se usa ANTHROPIC_API_KEY o GEMINI_API_KEY de arriba.
LLM_BASE_URL=http://host.docker.internal:1234/v1

# Overrides opcionales de nombres de modelo de ComfyUI (por si cambian en tu
# instalacion). Valores por defecto = los que trae E:\AI-Studio.
# COMFY_WAN_T2V_HIGH=Wan2.2-T2V-A14B-HighNoise-Q3_K_S.gguf
# COMFY_WAN_T2V_LOW=Wan2.2-T2V-A14B-LowNoise-Q3_K_S.gguf
# COMFY_WAN_HIGH=Wan2.2-I2V-A14B-HighNoise-Q3_K_S.gguf   # para encadenar segmentos
# COMFY_WAN_LOW=Wan2.2-I2V-A14B-LowNoise-Q3_K_S.gguf
# COMFY_MAX_REAL_SEGMENTS=8    # renders reales de ~4s encadenados por seccion
# COMFY_VIDEO_W=832 / COMFY_VIDEO_H=480   # resolucion nativa Wan (16:9)
# LTX:  COMFY_LTX_UNET / COMFY_LTX_VAE / COMFY_LTX_T5 / COMFY_LTX_STEPS(30) / COMFY_LTX_MAX_FRAMES(185)

# =============================================================================
# IMAGENES DE FONDO
# =============================================================================

# Pexels — fotos reales relacionadas al tema (gratis). https://www.pexels.com/api/
PEXELS_API_KEY=...

# Pixabay — alternativa a Pexels (gratis). https://pixabay.com/api/docs/
PIXABAY_API_KEY=...

# Unsplash — otra fuente de imagenes (gratis). https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=...

# =============================================================================
# AVATAR LIP-SYNC (D-ID)
# =============================================================================

# D-ID — genera avatar hablando a partir de imagen + audio. https://www.d-id.com/
DID_API_KEY=...

# =============================================================================
# PUBLICACION EN REDES SOCIALES (via /canales en la UI)
# =============================================================================

# YouTube Data API v3 — sube Shorts automaticamente
# Guia: console.cloud.google.com → YouTube Data API v3 → OAuth (App escritorio)
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...    # se genera automaticamente al conectar desde /canales

# TikTok Content Posting API — publica directamente en TikTok
# Guia: developers.tiktok.com → crear app → Content Posting API
# Redirect URI a registrar: http://localhost:8000/api/accounts/tiktok/callback
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...

# Instagram Graph API — publica Reels en Instagram Business/Creator
# Guia: developers.facebook.com → crear app Business → Instagram Graph API
# Redirect URI a registrar: http://localhost:8000/api/accounts/instagram/callback
# Requiere: cuenta Instagram Business vinculada a una pagina de Facebook
INSTAGRAM_APP_ID=...
INSTAGRAM_APP_SECRET=...

# Telegram Bot — publica videos en un canal o grupo
# Guia: habla con @BotFather en Telegram → /newbot → copia el token
# Chat ID: ID del canal/grupo donde publicar (ej: -1001234567890)
#   Para obtenerlo: añade @userinfobot al canal y escribe /start
#   O usa: https://api.telegram.org/bot<TOKEN>/getUpdates tras enviar un mensaje
# Se configura desde la UI en /canales (no hace falta poner aqui)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# =============================================================================
# ALMACENAMIENTO (se configura desde la UI en /settings)
# =============================================================================
# Los destinos de almacenamiento se guardan en _config/storage.json.
# Drive y SMB requieren rclone instalado y configurado (rclone config).
#
# Tipos disponibles:
#   local  → copia a una carpeta local del sistema
#   drive  → sube a Google Drive via rclone (ej: rclone_remote = "gdrive:Reels")
#   smb    → copia a red local via rclone  (ej: rclone_remote = "nas:Videos/Reels")
#
# Ejemplo de config en _config/storage.json:
# {
#   "destinations": [
#     {"name": "Descargas", "type": "local", "path": "/Users/tu/Descargas/Reels", "enabled": true},
#     {"name": "Drive",     "type": "drive", "rclone_remote": "gdrive:Reels",      "enabled": true},
#     {"name": "NAS",       "type": "smb",   "rclone_remote": "nas:Videos/Reels",  "enabled": false}
#   ]
# }
