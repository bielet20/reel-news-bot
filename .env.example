# Todas estas variables son OPCIONALES: el bot funciona igual sin ninguna
# (usa fallbacks automaticos en cada paso). Configuralas solo si queres
# mejorar la calidad de un paso en particular.

# --- Guion del reel (orden de prioridad: Ollama -> Claude -> Gemini -> Groq -> extractivo) ---

# Si se define, el bot usa Claude para generar el guion del reel en vez del
# resumen extractivo. Obtene tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de Claude a usar (opcional, default: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# Alternativa gratuita a Claude: Gemini 2.0 Flash (hasta 1500 peticiones/dia).
# Obtene tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Otra alternativa gratuita: Groq (Llama 3.3 70B, hasta 14400 peticiones/dia).
# Obtene tu clave en: https://console.groq.com/keys
GROQ_API_KEY=...

# Si tenes Ollama corriendo en local (https://ollama.com), se usa primero que
# todo lo anterior porque es gratis y no requiere internet. Modelo (default: llama3.2)
OLLAMA_MODEL=llama3.2

# --- Voz narrada (texto a voz) ---

# Voz neuronal de edge-tts a usar (default: es-ES-AlvaroNeural). Para ver el
# listado completo de voces en espanol disponibles: edge-tts --list-voices
TTS_VOICE=es-ES-AlvaroNeural

# --- Fondo de los reels de articulos ---

# Si se define, el bot busca una foto real relacionada al tema de la noticia
# en Pexels en vez de usar el fondo con degradado procedural. Gratis, obtene
# tu clave en: https://www.pexels.com/api/
PEXELS_API_KEY=...
