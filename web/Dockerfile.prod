# ── Fase 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# CA local extra (opcional, ver web/Dockerfile para el porque)
COPY certs/ /app/certs/
ARG EXTRA_CA_CERT=
ENV NODE_EXTRA_CA_CERTS=${EXTRA_CA_CERT}

COPY package*.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
# BACKEND_URL sólo se usa en rewrites (server-side), no se expone al cliente
ENV BACKEND_URL=http://backend:8000

RUN npm run build

# ── Fase 2: imagen final (sin devDependencies) ────────────────────────────────
FROM node:20-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.ts ./next.config.ts

EXPOSE 3000

CMD ["npm", "start"]
